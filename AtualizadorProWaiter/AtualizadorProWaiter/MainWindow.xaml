<Window xmlns:Controles="clr-namespace:NewSharp.AtualizadorProWaiter.Controles"  x:Class="AtualizadorProWaiter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AtualizadorProWaiter"
        mc:Ignorable="d"
        Title="Atualizador ProWaiter" Height="500" Width="700" MinWidth="700" WindowStartupLocation="CenterScreen" Closing="Window_Closing" ResizeMode="NoResize" >
    <Grid Background="#f0f0f0" Name="grid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="72*"/>
            <RowDefinition Height="347*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="AliceBlue" Grid.ColumnSpan="2">
            <Label Name="lblTituloAtualizador" Margin="20,20,0,0" FontSize="18" FontWeight="Bold" Content="Atualização do ProWaiter" />
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="10,10,0,0">
            <Label Name="lblNovaVersao" FontWeight="Bold" Content="Notas da versão"/>
            <Label Name="lblBackupVersaoLocal" Content="Executando backup da versão local"/>
            <Label Name="lblAtualizandoSistema" Content="Atualizando o sistema"/>
            <Label Name="lblFim" Content="Fim"/>
        </StackPanel>
        <Controles:UCNotasDaVersao x:Name="ucNotasDaVersao" Grid.Row="1" Grid.Column="1" Margin="8,0,8,0" Visibility="Visible"/>
        <Controles:UCAtualizacao x:Name="ucAtualizacao" Grid.Row="1" Grid.Column="1" Margin="8,5,8,10" Visibility="Hidden" Height="Auto"/>
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0">
            <Button x:Name="btnAvancar" Content="&lt; Avançar" Click="btnAvancar_Click" Width="75" Margin="3,12,10,12"/>
        </StackPanel>
    </Grid>
</Window>
