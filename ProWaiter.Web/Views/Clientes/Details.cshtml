@model ProWaiter.Web.Models.Entidades.Cliente

@{
    ViewBag.Title = "Cliente";
}

<h2>@AppResources.StringDetalhes</h2>

<div>
    <h4>@ViewBag.Title</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Nome)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Telefone1)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Telefone1)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Telefone2)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Telefone2)
        </dd>
    </dl>
    <div style="margin-bottom:15px;">
        @Html.Partial("_ListaEnderecosHelperSemAcoes")
    </div>
</div>
<p>
    @Html.Partial("_botaoVoltarParaLista")
    @Html.Partial("_botaoEditar", new { id = Model.Codigo })
</p>



