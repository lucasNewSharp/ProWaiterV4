@model ProWaiter.Web.Models.Entidades.Cliente

@{
    ViewBag.Title = "Cliente";
    if (ViewBag.Modal != null && (bool)ViewBag.Modal)
    {
        Layout = null;
    }
}

@if (ViewBag.Modal == null || !(bool)ViewBag.Modal) //não é modal
{

    <h2>@AppResources.StringEditar</h2>

    using (Html.BeginForm())
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-horizontal">
            <h4>@ViewBag.Title</h4>
            <hr />
            @Html.Partial("_EditHelper", Model)


            <div class="form-group">
                <div class="col-md-offset-3 col-md-9">
                    @Html.Partial("_botaoSalvar")
                </div>
            </div>

            <div class="form-group">
                @Html.Partial("_ListaEnderecosHelper", Model)
            </div>
        </div>
    }

    <div>
        @Html.Partial("_botaoVoltarParaLista")
    </div>
}
else //eh modal
{
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">@ViewBag.Title</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm(new { returnUrl = ViewBag.ReturnUrl }))
                {


                    <div class="form-horizontal">
                        @Html.Partial("_EditHelper", Model)
                    </div>
                    <div class="form-group">
                        @Html.Partial("_ListaEnderecosHelperSemAcoes", Model)
                    </div>
                    <div class="modal-footer">
                        @Html.Partial("_botaoSalvar")
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div id="modalEndereco" class="modal">
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () { })

        function ModalCadastroEndereco() {
            var codCliente = '@Model.Codigo';
            $("#modalEndereco").load("@Url.Action("Create", "EnderecosClientes")?codCliente=" + codCliente + "&codCidade=0" + "&returnUrl=@System.Net.WebUtility.UrlEncode(Context.Request.Path + Context.Request.QueryString.ToString())", function () {
                $("#modalEndereco").modal();
                $("#Endereco").focus();
            });
        }

        function ModalEditarEndereco(codEndereco) {
            $("#modalEndereco").load("@Url.Action("Edit", "EnderecosClientes")?id=" + codEndereco + "&returnUrl=@System.Net.WebUtility.UrlEncode(Context.Request.Path + Context.Request.QueryString.ToString())", function () {
                $("#modalEndereco").modal();
                $("#Endereco").focus();
            });
        }

    </script>
}




