@model ProWaiter.Web.Models.BootstrapDualListModelView

<div class="container larguraTotal">
    <br />
    <div class="row">

        <div class="dual-list list-left col-md-5">
            <div class="well text-right">
                <div class="row">
                    <div class="col-md-10">
                        <input type="text" name="SearchDualList" class="form-control" placeholder="Pesquisar" />
                    </div>
                    <div class="col-md-2">
                        <div class="btn-group">
                            <a class="btn btn-default selector" title="select all"><i class="glyphicon glyphicon-unchecked"></i></a>
                        </div>
                    </div>
                </div>
                <ul class="list-group">
                    @foreach (KeyValuePair<string, string> item in Model.ListaDisponiveis)
                    {
                        <li class="list-group-item">
                            @item.Value
                            <div class="hidden">@item.Key</div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="list-arrows col-md-1 text-center">
            <button class="btn btn-default btn-sm move-right" type="button">
                <span class="glyphicon glyphicon-chevron-right"></span>
            </button>
            <button class="btn btn-default btn-sm move-left" type="button">
                <span class="glyphicon glyphicon-chevron-left"></span>
            </button>
        </div>

        <div class="dual-list list-right col-md-5">
            <div class="well">
                <div class="row">
                    <div class="col-md-2">
                        <div class="btn-group">
                            <a class="btn btn-default selector" title="select all"><i class="glyphicon glyphicon-unchecked"></i></a>
                        </div>
                    </div>
                    <div class="col-md-10">
                        <input type="text" name="SearchDualList" class="form-control" placeholder="Pesquisar" />
                    </div>
                </div>
                <ul class="list-group">
                    @foreach (KeyValuePair<string, string> item in Model.ListaSelecionados)
                    {
                        <li class="list-group-item">
                            @item.Value
                            <div class="hidden">@item.Key</div>
                        </li>
                    }
                </ul>
                <input class="form-control" type="hidden" name="ItensSelecionados" value="" />
            </div>
        </div>
    </div>
</div>