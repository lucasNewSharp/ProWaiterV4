@model IEnumerable<ProWaiter.Web.Models.Entidades.Pedido>
@using ProWaiter.Web.Models.Entidades
@using ProWaiter.Web.Util

@{
    ViewBag.Title = "Pedidos";
}

@section metas {
    <meta http-equiv="refresh" content="60">
}

@section css {
    <link href="~/Content/statusEnviado.css" rel="stylesheet" />
}

<h2>@ViewBag.Title</h2>


<p>
    @{
        if (!string.IsNullOrWhiteSpace(Configuracoes.ObterInstancia().PortaCOMIntegracaoICBox))
        {
            @Html.BotaoAcaoTexto("CreatePeloTelefone", "PedidosExternos", "Entrega (bina)")
        }
    }
    @Html.BotaoAcaoTexto("Create", "PedidosExternos", "Entrega")
    @Html.BotaoAcaoTexto("Create", "PedidosParaLevar", "Para Levar")
    @Html.BotaoAcaoTexto("Create", "PedidosInternos", "Interno")
    @{
        string textoBotao = ViewBag.ExibirFiltros == "1" ? "Ocultar Filtros" : "Exibir Filtros";
    }
    <button id="btnExibirFiltros" class="btn btn-danger" onclick="exibirFiltros();" value="">@textoBotao</button>
</p>


@using (Html.BeginForm(null, null, null, FormMethod.Post, true, new { id = "formulario" }))
{    
    <div class="container col-md-12 filtros">
        <div class="form-group col-md-12">
            <div>
                @Html.CheckBox("liberarConsulta", htmlAttributes: new { @id = "liberarConsulta" })                
                <label class="control-label">Liberar consulta maior do que 3 dias</label>
            </div>
        </div>
    </div>
    <div class="container col-md-12 filtros">

        <div class="form-group col-md-2">
            <div>
                <label class="control-label">Fechados</label>
                @Html.DropDownList("fechado", (SelectList)ViewBag.SatusFechado, htmlAttributes: new { @class = "form-control", @id = "ddlFechados" })
            </div>
        </div>
        <div class="form-group col-md-2">
            <label class="control-label">Enviado</label>
            @Html.DropDownList("enviado", (SelectList)ViewBag.StatusEnviado, htmlAttributes: new { @class = "form-control", @id = "ddlStatus" })
        </div>
        <div class="form-group col-md-2">
            <label class="control-label">Desde</label>
            <input type="date" id="dataInicio" name="dataInicio" class="form-control" value="@ViewBag.DataInicio" />
        </div>
        <div class="form-group col-md-2">
            <label class="control-label">Tipo</label>
            @Html.DropDownList("tipo", (SelectList)ViewBag.TiposPedido, htmlAttributes: new { @class = "form-control", @id = "ddlTiposPedido" })
        </div>
        <div class="form-group col-md-2">
            <label class="control-label">Filtro</label>
            <input type="text" id="filtro" name="filtro" class="form-control" value="@ViewBag.Filtro" />
        </div>
        <div class="form-group col-md-2">
            <label>Ações</label>
            <div>
                <button type="submit" class="btn btn-default" data-toggle="tooltip" title="Filtrar">
                    <div class="glyphicon glyphicon-search"></div>
                </button>
                <button type="button" class="btn btn-default" data-toggle="tooltip" title="Limpar Filtros" onclick="LimparFiltros()">
                    <div class="glyphicon glyphicon-erase"></div>
                </button>
            </div>
        </div>

    </div>

}

<br />
<br />

@if (!string.IsNullOrEmpty(ViewBag.Erro))
{
    <br />
    <br />
    <br />
    <div class="alert-danger">
        <p>@ViewBag.Erro</p>
    </div>
}

<table class="table table-hover">
    <tr>
        <th>
            @if (ViewBag.UtilizaComanda)
            {
                <span>Comanda - Local</span>
            }
            else
            {
                <span>Mesa</span>
            }
        </th>
        <th>
            Situação
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DataInicio)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ValorTotal)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NomeUsuario)
        </th>
        <th>Status Impressoras</th>
        <th></th>
    </tr>
    @{
        int i = 0;
        foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (item is PedidoExterno pedidoExterno)
                    {
                        if (ViewBag.ExibirSequencialTeleEntrega)
                        {
                            <span>@pedidoExterno.SequencialNoDia.ToString("0000") -</span>
                        }
                        @Html.DisplayFor(modelItem => pedidoExterno.Cliente.Nome)
                    }
                    else if (item is PedidoInterno pedInt)
                    {
                        if (pedInt.Mesa != null)
                        {
                            <span>@pedInt.Mesa.Descricao.Trim()</span>
                        }
                        else
                        {
                            if (ViewBag.UtilizaComanda)
                            {
                                <span>Comanda Liberada</span>
                            }
                            else
                            {
                                <span>Pedido interno sem mesa</span>
                            }
                        }


                        if (pedInt.LocalInterno != null)
                        {
                            <span>-&nbsp;@pedInt.LocalInterno.Nome</span>
                        }
                    }
                    else
                    {
                        <span>Pedido Para Levar</span>
                    }
                </td>
                <td>
                    @{
                        string texto = string.Empty;
                        string badge = "";
                        if (item.DataTermino.HasValue)
                        {
                            texto = "Fechado";
                            badge = "label-enviado";
                        }
                        else
                        {
                            texto = "Aberto";
                            badge = "label-naoEnviado";
                        }
                    }
                    <span class="label @badge">@texto</span>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataInicio)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ValorTotal)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NomeUsuario)
                </td>
                <td>
                    @if (item.TodosItensEnviados)
                    {
                        <span class="label label-enviado">Itens enviados</span>
                    }
                    else
                    {
                        <span class="label label-naoEnviado glyphicon-">Itens à enviar</span>
                    }
                </td>
                @if (item is PedidoInterno)
                {
                    <td>


                        @Html.BotaoAcaoImagem(eTipoBotao.Editar, "Edit", "Pedidos", new { id = item.Codigo }, "Editar Pedido")
                        @Html.BotaoAcaoImagem(eTipoBotao.Detalhes, "Details", "PedidosInternos", new { id = item.Codigo }, "Detalhes")
                        @Html.BotaoAcaoImagem(eTipoBotao.Excluir, "Delete", "PedidosInternos", new { id = item.Codigo }, "Excluir")
                        @Html.BotaoAcaoTexto("Edit", "Pedidos", "Fechar Pedido", new { id = item.Codigo, nomeModalAberta = "modalFecharPedido" })

                        @if (!string.IsNullOrWhiteSpace(item.Observacoes))
                        {
                            <span id="info_@i" class="glyphicon glyphicon-info-sign clToolTip" data-toggle="tooltip" data-placement="right" title="@item.Observacoes"></span>
                            i++;
                        }

                    </td>
                }
                else if (item is PedidoExterno)
                {
                    <td>
                        @Html.BotaoAcaoImagem(eTipoBotao.Editar, "Edit", "Pedidos", new { id = item.Codigo }, "Editar Pedido")
                        @Html.BotaoAcaoImagem(eTipoBotao.Detalhes, "Details", "PedidosExternos", new { id = item.Codigo }, "Detalhes")
                        @Html.BotaoAcaoImagem(eTipoBotao.Excluir, "Delete", "PedidosExternos", new { id = item.Codigo }, "Excluir")
                        @Html.BotaoAcaoTexto("Edit", "Pedidos", "Fechar Pedido", new { id = item.Codigo, nomeModalAberta = "modalFecharPedido" })

                        @if (!string.IsNullOrWhiteSpace(item.Observacoes))
                        {
                            <span id="info_@i" class="glyphicon glyphicon-info-sign clToolTip" data-toggle="tooltip" data-placement="right" title="@item.Observacoes"></span>
                            i++;
                        }
                    </td>
                }
                else
                {
                    <td>
                        @Html.BotaoAcaoImagem(eTipoBotao.Editar, "Edit", "Pedidos", new { id = item.Codigo }, "Editar Pedido")
                        @Html.BotaoAcaoImagem(eTipoBotao.Detalhes, "Details", "PedidosParaLevar", new { id = item.Codigo }, "Detalhes")
                        @Html.BotaoAcaoImagem(eTipoBotao.Excluir, "Delete", "PedidosParaLevar", new { id = item.Codigo }, "Excluir")
                        @Html.BotaoAcaoTexto("Edit", "Pedidos", "Fechar Pedido", new { id = item.Codigo, nomeModalAberta = "modalFecharPedido" })
                        @if (!string.IsNullOrWhiteSpace(item.Observacoes))
                        {
                            <span id="info_@i" class="glyphicon glyphicon-info-sign clToolTip" data-toggle="tooltip" data-placement="right" title="@item.Observacoes"></span>
                            i++;
                        }
                    </td>
                }
            </tr>
        }
    }
    <tr>
        <td colspan="2"><b>Valor Total dos Pedidos:</b></td>
        <td><b>@ViewBag.TotalPedidos</b></td>
        <td colspan="3"></td>
    </tr>
</table>



@section scripts{

    <script type="text/javascript">

        $(document).ready(function () {

            var btnExibirFiltros = $('#btnExibirFiltros');
            if ('@ViewBag.ExibirFiltros' == 1) {
                $('.filtros').show();
                btnExibirFiltros.val(1);
            }
            else {
                $('.filtros').hide();
                btnExibirFiltros.val(0);
            }

            $(".clToolTip").each(function (indice, e) {
                var ele = $("#info_" + indice);
                ele.tooltip();
            });

            $("#filtro").keyup(function (e) {
                if (e.keyCode == 27)
                    LimparFiltros();
            });

            $("#ddlStatus").keyup(function (e) {
                if (e.keyCode == 27)
                    LimparFiltros();
            });

            $("#ddlStatus").change(function (e) {
                $("#formulario").submit();
            });

            $("#ddlFechados").keyup(function (e) {
                if (e.keyCode == 27)
                    LimparFiltros();
            });

            $("#ddlFechados").change(function (e) {
                $("#formulario").submit();
            });

            $("#ddlTiposPedido").keyup(function (e) {
                if (e.keyCode == 27)
                    LimparFiltros();
            });

            $("#ddlTiposPedido").change(function (e) {
                $("#formulario").submit();
            });

            $("#dataInicio").change(function (e) {
                $("#formulario").submit();
            });
        });

        function LimparFiltros() {
            $('#ddlFechados').val('');
            $('#dataInicio').val(null);
            $("#filtro").val(null);
            $("#ddlStatus").val('');
            $("#formulario").submit();
        }

        function exibirFiltros() {
            var btn = $('#btnExibirFiltros');
            var val = btn.val();
            if (val == 1) {
                btn.html("Exibir Filtros");
                btn.val(0);
                $('.filtros').hide();
                val = 0;
            }
            else {
                btn.html("Ocultar Filtros")
                btn.val(1);
                $('.filtros').show();
                val = 1;
            }

            $.ajax({
                url: '@Url.Action("SalvarCoockieExibirFiltros", "Pedidos")',
                type: "POST",
                dataType: "JSON",
                data: { exibirFiltros: val.toString() },
                success: function () {
                },
                error: function () {
                }
            });
        }

    </script>

}



