                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    <div class="@(ViewBag.RefeicoesCustomizadas.Count > 0 ? "col-lg-6" : "col-lg-12")">
                        <div class="row">
                            <label class="control-label col-md-4">@Html.DisplayNameFor(p => p.ValorBebidas)</label>
