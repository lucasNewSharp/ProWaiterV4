        }

        function ValidarAdicaoBebidas() {
            if ($("#listaCodBebidas").find(":selected").length != 1) {
                ExibirMensagemBebida(true, "Você deve selecionar uma bebida!");
                return false;
            }
            else if ($("#quantidadeBeb").val() < 1) {
                ExibirMensagemBebida(true, "A quantidade de ser maior ou igual a 1 unidade!");
                return false;
            }
            else {
                $("#msgAddBeb").addClass("hidden");
                return true;
            }
        }

        function AdicionarBebida() {
            $("#msgAddBeb").addClass("hidden");
            var codPedido = @Model.Codigo;
            var codBebida = $("#listaCodBebidas").find(":selected").val();
            var quantidade = $("#quantidadeBeb").val();
            var observacoes = $("#observacaoBeb").val();
            if (ValidarAdicaoBebidas()) {
                $.ajax({
                    url: '@Url.Action("AdicionarBebida", "Pedidos")',
                    type: "POST",
                    dataType: "JSON",
                    data: { codPedido: codPedido, codBebida: codBebida, quantidade: quantidade, observacoes: observacoes },
                    success: function () {
                        PopularBebidas();
                        $("#quantidadeBeb").val(1);
                        $("#observacao").val("");
                        AtualizarInterfaceComValorAtualPedido();
                        ExibirMensagemBebida(false, "Bebida(s) adicionada(s) com sucesso!");
                    },
                    error: function () {
                        ExibirMensagemBebida(true, "Erro ao Adicionar Bebida(s)!");
                    }
                });
            }
        }

