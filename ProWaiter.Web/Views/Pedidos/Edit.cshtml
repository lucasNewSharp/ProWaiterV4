@model ProWaiter.Web.Models.Entidades.Pedido
@using ProWaiter.Web.Models.Entidades
@using ProWaiter.Web.Util

@{
    if (Model is PedidoInterno)
    {
        ViewBag.Title = "Pedido Interno";
    }
    else if (Model is PedidoExterno)
    {
        ViewBag.Title = "Pedido Para Entrega";
    }
    else
    {
        ViewBag.Title = "Pedido Para Levar";
    }

}

@section css {
    <link href="~/Content/statusEnviado.css" rel="stylesheet" />
    <style type="text/css">
        #listaCodComponentes {
            max-height: 330px;
            overflow-y: scroll;
        }

        .txtDinheiro {
            width: 140px;
        }
    </style>
}

<h2>@AppResources.StringEditar</h2>

@if (!string.IsNullOrWhiteSpace(ViewBag.ErrosImpressao))
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrosImpressao
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>@ViewBag.Title</h4>
        <a class="btn btn-primary" data-toggle="modal" data-target="#modalAdicionarItensModelo">Adicionar itens a partir de modelo</a>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Codigo)

        @{
            if (Model is PedidoInterno)
            {
                <div class="form-group">
                    @Html.Label("DescricaoMesa", Configuracoes.ObterInstancia().StringTipoLocalEntrega, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <input type="text" class="form-control text-box single-line" readonly="readonly" value="@ViewBag.DescricaoMesa" />
                    </div>
                </div>
                if (Configuracoes.ObterInstancia().UtilizaComanda)
                {
                    <div class="form-group">
                        @Html.LabelFor(model => ((PedidoInterno)model).LocalInterno, "Local entrega", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownList("CodLocalInterno", null, htmlAttributes: new { @class = "form-control", @id = "ddlLocaisInternos" })
                            @Html.ValidationMessageFor(model => ((PedidoInterno)model).LocalInterno, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="form-group">
                    @Html.Label("NomeCliente", "Cliente", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <input type="text" class="form-control text-box single-line" readonly="readonly" value="@ViewBag.NomeCliente" />
                    </div>
                </div>

                if (Model is PedidoExterno pedExterno)
                {
                    @Html.HiddenFor(p => pedExterno.CodCliente);
                    <div class="form-group">
                        @Html.Label("ValorEntrega", "Valor entrega: R$", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <input name="ValorEntrega" id="ValorEntrega" class="form-control col-md-4" value="@ViewBag.ValorEntrega" />
                            <div style="padding-right:0; display:inline" class="col-md-1">
                                <div class="glyphicon glyphicon-floppy-disk btn btn-primary btn-lg" id="btnSalvarValorEntrega" data-toggle="tooltip" data-placement="right" title="Salva o valor de entrega" onclick="SalvarValorEntrega('@Model.Codigo')"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("CodEndereco", "Endereço entrega", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownList("EnderecosEntrega", null, htmlAttributes: new { @class = "form-control col-md-8", @id = "ddlEnderecos", @onchange = "AtualizarEnderecoEntregaPedido()" })
                            <div class="col-md-1" style="width:10px; height:20px; align-content:center;"><span class="glyphicon glyphicon-info-sign" id="tooltipDadosEndereco" data-toggle="tooltip" data-placement="right" data-html="true" data-original-title=""></span></div>
                            <div class="btn btn-default glyphicon glyphicon-plus btnCadastrarEndereco col-md-1" onclick="ModalCadastroEndereco()" title="Cadastrar novo..." style="margin-left:10px; width:50px;"></div>
                            <div class="btn btn-default glyphicon glyphicon-edit btnEditarEndereco col-md-1" onclick="ModalEditarEndereco()" title="Editar selecionado..." style="margin-left:10px; width:50px;"></div>

                        </div>

                    </div>
                }

            }
        }

        <div class="form-group">
            @Html.LabelFor(model => model.Observacoes, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Observacoes, new { htmlAttributes = new { @class = "form-control col-md-4", @id = "txtObservacoesPedido" } })
                @Html.ValidationMessageFor(model => model.Observacoes, "", new { @class = "text-danger" })

                <div style="padding-right:0; display:inline" class="col-md-1">
                    <div class="glyphicon glyphicon-floppy-disk btn btn-primary btn-lg" id="btnSalvarObsPedido" data-toggle="tooltip" data-placement="right" title="Salva as observações" onclick="SalvarObsPedido('@Model.Codigo')"></div>
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DataInicio, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.DataInicio, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DataInicio, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.NomeUsuario, "Usuário", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NomeUsuario, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.NomeUsuario, "Valor atual", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <p class="form-control-static" id="valorAtualPedido">R$&nbsp;@Html.DisplayFor(model => model.ValorTotal)</p>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Cod. Barras</label>
            <div class="col-md-10">
                <input id="qtdItemCodBarras" class="form-control col-md-2" value="1" style="width:60px; margin-right:5px;" title="Quantidade" />
                <input id="txtCodBarras" class="form-control col-md-6" />
                <div class="btn btn-default glyphicon glyphicon-plus btnAddItemCodBarras col-md-1" onclick="AdicionarItemCodBarras()" title="Adicionar item pelo codigo de barras" style="margin-left:10px; width:50px;"></div>
                <div class="col-md-3">
                    @{
                        string ck = ViewBag.MarcarCodBarrasComoEnviada ? "checked" : "";
                    }
                    <input id="ckbMarcarCodBarrasComoEnviado" @ck type="checkbox" />
                    <span for="ckbMarcarCodBarrasComoEnviado">Marcar como enviado</span>
                </div>
            </div>
        </div>

        @* http://stackoverflow.com/questions/32322775/how-to-remove-a-list-item-border-in-bootstrap-list-group *@
        <div class="form-group">
            @Html.LabelFor(model => model.RefeicoesDoPedido, "Refeições", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-1">
                <button type="button" class="btn btn-primary btn-lg" data-toggle="modal" data-target="#modalAdicionarRefeicao">
                    <div class="glyphicon glyphicon-plus"></div>
                </button>
            </div>
            <div class="col-md-6">
                <div class="list-group">
                    @foreach (var refeicao in Model.RefeicoesDoPedido)
                    {
                        <script type="text/javascript">
                            var textoToolTipComp = "";
                        </script>

                        string id = "ref_" + refeicao.Codigo.ToString();
                        string idToolTipComp = "toolTip_" + refeicao.Codigo.ToString();
                        <div class="row">
                            <div class="list-group-item row col-md-9">
                                <div class="cursor-pointer itemRefeicao col-md-7" data-toggle="collapse" data-target="#@id" style="padding:0px;">
                                    <div class="glyphicon glyphicon-chevron-right" id="gi_@id"></div>

                                    @if (refeicao.RefeicaoDoCardapio.DeComposicao)
                                    {
                                        <span class="glyphicon glyphicon-info-sign toolTipComponentesCompostosClass" id="@idToolTipComp" data-toggle="tooltip" data-placement="right" data-html="true" data-original-title="">
                                        </span>
                                    }

                                    @refeicao.RefeicaoDoCardapio.Refeicao.Nome (@refeicao.RefeicaoDoCardapio.TamanhoRefeicao.Nome)
                                </div>
                                <div class="col-md-4">
                                    @if (refeicao.Enviado)
                                    {
                                        <span class="label label-enviado">Item enviado</span>
                                    }
                                    else
                                    {
                                        <span class="label label-naoEnviado">Item à enviar</span>
                                    }
                                </div>
                                <span class="col-md-1" style="padding:0px;">
                                    <a class="btn btn-xs btn-danger" onclick="javascript: PedirConfirmacao('@Url.Action("RemoverRefeicao", "Pedidos", new { codRefeicaoDoPedido = refeicao.Codigo })')">
                                        <span class="glyphicon glyphicon-remove"></span>
                                    </a>
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(refeicao.NomeUsuario))
                            {
                                <div style="display:inline; align-content:center; margin-left:17px; margin-top:8px;" class="col-md-2 badge">
                                    <span style="vertical-align:central">@refeicao.NomeUsuario</span><br />
                                    @{
                                        string data = refeicao.DataHora.HasValue ? refeicao.DataHora.Value.ToShortTimeString() : string.Empty;
                                    }
                                    <span style="vertical-align:central">@data</span>
                                </div>
                            }
                        </div>

                        <div id="@id" class="collapse row">
                            <ul>
                                @if (refeicao.RefeicaoDoCardapio.DeComposicao)
                                {
                                    foreach (var componenteRefeicao in refeicao.RefeicaoDoCardapio.ComponentesComposicaoRefeicao.OrderBy(c => c.ComponenteRefeicao.Nome))
                                    {
                                        string idComponente = refeicao.Codigo.ToString() + "_" + componenteRefeicao.CodComponente.ToString();
                                        <li class="list-group-item col-md-12">
                                            <div class="col-md-9" style="padding:0px;">
                                                @componenteRefeicao.ComponenteRefeicao.Nome
                                            </div>


                                            @{
                                                string checado = "";

                                                if (refeicao.ComponentesRefeicaoPedido.Select(c => c.ComponenteRefeicao).Contains(componenteRefeicao.ComponenteRefeicao))
                                                {
                                                    checado = "checked";

                                                    var compProporcional = refeicao.ComponentesRefeicaoPedido.Where(c => c.CodComponente == componenteRefeicao.CodComponente).Single();

                                                    if (string.IsNullOrWhiteSpace(componenteRefeicao.CodUnidade))
                                                    {
                                                        <script type="text/javascript">
                                                            textoToolTipComp += '@componenteRefeicao.ComponenteRefeicao.Nome' + "<br />";
                                                        </script>
                                                    }
                                                    else
                                                    {
                                                        <script type="text/javascript">
                                                            textoToolTipComp += '@componenteRefeicao.ComponenteRefeicao.Nome' + "(" + '@compProporcional.Quantidade.ToString()' + ")<br />";
                                                        </script>
                                                    }
                                                }
                                                <span class="col-md-1" style="padding:0px;">
                                                    <input type="checkbox" id="@idComponente" @checado onclick="AtualizarComponente(this, '@refeicao.Codigo', '@componenteRefeicao.CodComponente', true)" />
                                                </span>

                                                if (!string.IsNullOrWhiteSpace(componenteRefeicao.CodUnidade))
                                                {
                                                    string desabilitado = "";
                                                    string quantidade = "";

                                                    if (string.IsNullOrWhiteSpace(checado))
                                                    {
                                                        desabilitado = "disabled";
                                                    }
                                                    else
                                                    {
                                                        var compProporcional = refeicao.ComponentesRefeicaoPedido.Where(c => c.CodComponente == componenteRefeicao.CodComponente).Single();
                                                        quantidade = compProporcional.Quantidade.ToString();
                                                    }

                                                    <span class="col-md-2" style="padding:0px;">
                                                        @{
                                                            string idNud = "nud_" + refeicao.Codigo + "_" + componenteRefeicao.CodComponente.ToString();
                                                        }
                                                        <input type="number" onchange="AtualizarComponente(null, '@refeicao.Codigo', '@componenteRefeicao.CodComponente', false)" id="@idNud" class="form-control" @desabilitado value="@quantidade" />
                                                    </span>
                                                }
                                                <script type="text/javascript">
                                                    var txt = "<div>" + textoToolTipComp + "</div>";
                                                    document.getElementById('@idToolTipComp').setAttribute("data-original-title", txt);
                                                </script>
                                            }

                                        </li>
                                    }
                                }
                                else
                                {
                                    foreach (var componenteRefeicao in refeicao.RefeicaoDoCardapio.Refeicao.ComponentesRefeicao.OrderBy(c => c.Nome))
                                    {
                                        string idComponente = refeicao.Codigo.ToString() + "_" + componenteRefeicao.Codigo.ToString();
                                        <li class="list-group-item col-md-12">
                                            <div class="col-md-11" style="padding:0px;">
                                                @componenteRefeicao.Nome
                                            </div>
                                            <span class="col-md-1" style="padding:0px;">
                                                @if (refeicao.ComponentesRefeicaoPedido.Select(c => c.ComponenteRefeicao).Contains(componenteRefeicao))
                                                {
                                                    <input type="checkbox" id="@idComponente" checked onclick="AtualizarComponente(this, '@refeicao.Codigo', '@componenteRefeicao.Codigo', false)" />
                                                }
                                                else
                                                {
                                                    <input type="checkbox" id="@idComponente" onclick="AtualizarComponente(this, '@refeicao.Codigo', '@componenteRefeicao.Codigo', false)" />
                                                }
                                            </span>

                                        </li>
                                    }
                                }
                                <li class="list-group-item col-md-12 liObservacoes">
                                    <div class="col-md-9" style="padding:0;">
                                        <textarea class="form-control" id="obsRef_@refeicao.Codigo">@refeicao.Observacoes</textarea>
                                    </div>
                                    <div class="col-md-3" style="padding-right:0;">
                                        <div class="glyphicon glyphicon-floppy-disk btn btn-primary btn-lg" onclick="SalvarObsRefs('obsRef_@refeicao.Codigo')"></div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.BebidasDoPedido, "Bebidas", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-1">
            </div>
            <div class="col-md-6">
                <div class="list-group">
                    @foreach (var bebida in Model.BebidasDoPedido)
                    {
                        string id = "beb_" + bebida.Codigo.ToString();
                        <div class="row">
                            <div class="list-group-item row col-md-9">
                                <div class="col-md-7 itemRefeicao" style="padding:0;" data-toggle="collapse" data-target="#@id">
                                    <div class="glyphicon glyphicon-chevron-right" id="gi_@id"></div>
                                    @bebida.Bebida.Nome
                                </div>
                                <div class="col-md-4">
                                    @if (bebida.Enviado)
                                    {
                                        <span class="label label-enviado">Item enviado</span>
                                    }
                                    else
                                    {
                                        <span class="label label-naoEnviado">Item à enviar</span>
                                    }
                                </div>
                                <span class="col-md-1" style="padding:0">
                                    <a class="btn btn-xs btn-danger" onclick="javascript: PedirConfirmacao('@Url.Action("RemoverBebida", "Pedidos", new { codBebidaDoPedido = bebida.Codigo })')">
                                        <span class="glyphicon glyphicon-remove"></span>
                                    </a>
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(bebida.NomeUsuario))
                            {
                                <div style="display:inline; align-content:center; margin-left:17px; margin-top:8px;" class="col-md-2 badge">
                                    <span style="vertical-align:central">@bebida.NomeUsuario</span><br />
                                    @{
                                        string data = bebida.DataHora.HasValue ? bebida.DataHora.Value.ToShortTimeString() : string.Empty;
                                    }
                                    <span style="vertical-align:central">@data</span>
                                </div>
                            }
                        </div>
                        <div id="@id" class="collapse row">
                            <div class="list-group-item col-md-12 liObservacoes">
                                <div class="col-md-9" style="padding:0;">
                                    <textarea class="form-control" id="obsBeb_@bebida.Codigo">@bebida.Observacoes</textarea>
                                </div>
                                <div class="col-md-3" style="padding-right:0;">
                                    <div class="glyphicon glyphicon-floppy-disk btn btn-primary btn-lg disabled" onclick="SalvarObsBebs('obsBeb_@bebida.Codigo')"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ItensBalcaoDoPedido, "Itens de balcão", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-7">
                <input id="qtdItemBalcao" class="form-control col-md-2" value="1" style="width:60px; margin-right:5px;" title="Quantidade" />
                @Html.DropDownList("ddlItensBalcao", (SelectList)ViewBag.CodItensBalcao, htmlAttributes: new { @class = "form-control col-md-9" })
                <div class="btn btn-default glyphicon glyphicon-plus btnAdicionarItemBalcao col-md-1" onclick="AdicionarItemBalcao()" title="Adicionar item de balcão" style="margin-left:10px; width:50px;"></div>
                <div class="col-md-3">
                    @{
                        string ckbSomenteItensSemCodBarrasChecked = ViewBag.ExibirSomenteItensBalcaoSemCodBarras ? "checked" : "";
                    }
                    <input id="ckbSomenteItensSemCodBarras" @ckbSomenteItensSemCodBarrasChecked type="checkbox" title="Exibe somente itens de balção sem codigo de barras" />
                    <span for="ckbSomenteItensSemCodBarras">Sem cod. barras</span>
                </div>
            </div>
        </div>
        <div class="form-group">
            @foreach (var itemBalcaoPedido in Model.ItensBalcaoDoPedido)
            {
                string id = "itemBalcaoPedido_" + itemBalcaoPedido.Codigo.ToString();
                <div class="row" style="margin-left:15px;">
                    <div class="col-md-2"></div>
                    <div class="list-group-item col-md-4">
                        <div class="col-md-11" style="padding:0;">
                            @itemBalcaoPedido.ItemBalcao.Nome
                        </div>
                        <span class="col-md-1" style="padding:0">
                            <a class="btn btn-xs btn-danger" onclick="javascript: PedirConfirmacao('@Url.Action("RemoverItemBalcao", "Pedidos", new { codItemBalcaoPedido = itemBalcaoPedido.Codigo })'); AtualizarInterfaceComValorAtualPedido()">
                                <span class="glyphicon glyphicon-remove"></span>
                            </a>
                        </span>
                    </div>
                    <div style="display:inline; align-content:center; margin-left:17px; margin-top:8px;" class="col-md-1 badge">
                        <span style="vertical-align:central">@itemBalcaoPedido.NomeUsuario</span><br />
                        @{
                            string data = itemBalcaoPedido.DataHora.ToShortTimeString();
                        }
                        <span style="vertical-align:central">@data</span>
                    </div>

                </div>
            }

        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">

                @{
                    bool imprimirLanchesPedidoExterno = Configuracoes.ObterInstancia().ImprimirLanchesPedidoExterno;
                    if (Model is PedidoExterno && !imprimirLanchesPedidoExterno)
                    {
                        <span id="toolTipoBotaoEnviarCozinha" title="Impressão de pedido externo desabilitado nas configurações">
                            <a type="button" id="btnEnviarCozinha" class="btn btn-primary disabled" href="#">Enviar à Cozinha</a>
                        </span>
                    }
                    else
                    {
                        <a type="button" class="btn btn-primary@(Model.TodosItensEnviados ? " disabled" : "")" href="@Url.Action("EnviarItensACozinha", "Pedidos", new { Id = Model.Codigo })">Enviar à Cozinha</a>
                    }
                }

                <input type="button" class="btn btn-warning" value="Fechar Pedido" data-toggle="modal" data-target="#modalFecharPedido" />
            </div>
        </div>
    </div>


}

<div id="modalAdicionarRefeicao" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">

        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Adicionar Item</h4>
            </div>
            <div class="modal-body">

                <ul class="nav nav-tabs">
                    <li id="tabRefeicoes" class="active"><a data-toggle="tab" href="#menuRefeicoes">Refeições</a></li>
                    <li id="tabBebidas"><a data-toggle="tab" href="#menuBebidas">Bebidas</a></li>
                </ul>
                <div class="tab-content">
                    <div id="menuRefeicoes" class="tab-pane fade active in" style="margin-top:20px">
                        <div class="row">
                            <label class="control-label col-md-2">Tipo</label>
                            @Html.DropDownList("ddlTipoRefeicao", (SelectList)ViewBag.CodTipoRefeicao, new { @id = "ddlCodTipoRefeicao", @class = "form-control col-md-4" })
                            <label class="control-label col-md-2">Quantidade</label>
                            <input class="form-control text-box single-line col-md-4" data-val="true" data-val-number="A quantidade deve ser um valor numérico." data-val-required="O campo quantidade é obrigatório." id="quantidadeRef" type="number" value="1" min="1">
                        </div><br />
                        <div class="row">
                            <label class="control-label col-md-2">Filtro</label>
                            <input class="form-control text-box single-line col-md-4" id="filtroRefeicao" type="text">
                            <label class="control-label col-md-2">Observação</label>
                            <input class="form-control text-box single-line col-md-4" id="observacao" type="text">
                        </div><br />
                        <div class="row">
                            <label class="control-label col-md-2">Refeição</label>
                            @Html.DropDownList("CodRefeicao", (SelectList)ViewBag.CodTipoRefeicao, new { @id = "listaCodRefeicoes", @class = "form-control col-md-4", @size = "15" })
                            <label class="control-label col-md-2">
                                Componentes
                                <span class="glyphicon glyphicon-info-sign" id="toolTipSaboresEscolhidosAddRefeicao" data-toggle="tooltip" data-placement="right" data-html="true" data-original-title="">
                                </span>
                            </label>
                            <ul id="listaCodComponentes" class="list-group col-md-4"></ul>
                        </div><br />
                        <div class="row">
                            <div class="col-md-12 alert alert-success hidden" id="msgAddRef">Refeição(ões) adicionada(s) com êxito!</div>
                        </div>
                        <div class="row">
                        </div>
                    </div>
                    <div id="menuBebidas" class="tab-pane fade" style="margin-top:20px">
                        <div class="row">
                            <label class="control-label col-md-2">Tipo</label>
                            @Html.DropDownList("ddlTipoBebida", (SelectList)ViewBag.CodTipoBebida, new { @id = "ddlCodTipoBebida", @class = "form-control col-md-10" })
                        </div><br />
                        <div class="row">
                            <label class="control-label col-md-2">Filtro</label>
                            <input class="form-control text-box single-line col-md-10" id="filtroBebida" type="text">
                        </div><br />
                        <div class="row">
                            <label class="control-label col-md-2">Bebida</label>
                            @Html.DropDownList("CodBebida", (SelectList)ViewBag.CodBebida, new { @id = "listaCodBebidas", @class = "form-control col-md-10", @size = "10" })
                        </div><br />
                        <div class="row">
                            <label class="control-label col-md-2">Quantidade</label>
                            <input class="form-control text-box single-line col-md-10" data-val="true" data-val-number="A quantidade deve ser um valor numérico." data-val-required="O campo quantidade é obrigatório." id="quantidadeBeb" type="number" value="1" min="1">
                        </div>
                        <br />
                        <div class="row">
                            <label class="control-label col-md-2">Observação</label>
                            <input class="form-control text-box single-line col-md-10" data-val="true" id="observacaoBeb" type="text">
                        </div><br />
                        <div class="row">
                            <div class="col-md-12 alert alert-success hidden" id="msgAddBeb">Bebida(s) adicionada(s) com êxito!</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button id="btnAdicionarItem" class="btn btn-primary">Adicionar</button>
                <button type="button" class="btn btn-default" data-dismiss="modal" onclick="javascript: location.reload();">Fechar</button>
            </div>
        </div>
    </div>
</div>


<div id="modalFecharPedido" class="modal fade" role="dialog">
    <div class="modal-dialog @(ViewBag.RefeicoesCustomizadas.Count > 0 ? "modal-lg" : "")">

        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Fechar Pedido</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    @if (ViewBag.RefeicoesCustomizadas.Count > 0)
                    {
                        <div class="col-lg-6">
