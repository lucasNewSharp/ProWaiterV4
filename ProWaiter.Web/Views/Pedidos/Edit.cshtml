        function AdicionarRefeicao() {
            FiltrarComponentesComposicao(null); //para listar todos os elemento
            $("#msgAddRef").addClass("hidden");
            var codPedido = @Model.Codigo;
            var selecionados = $("#listaCodRefeicoes").find(":selected");
            if (selecionados.length == 0) {
                return;
            }
            var valoresRef = selecionados.attr("value").split(';');
            var codRefeicao = valoresRef[0];
            var codTamanho = valoresRef[1];
            var quantidade = $("#quantidadeRef").val();
            var observacoes = $("#observacao").val();
            var componentes = $(".chkAddComponente:checked").map(function () {
                var checkbox = $(this);
                var codigo = checkbox.val();

                var idNud = checkbox.attr("idNud");
                var nud = $('#' + idNud);
                var qtd = 0;
                if (nud != "undefined") {
                    qtd = nud.val();
                }
                if (isNaN(qtd))
                    qtd = 1;

                return { Codigo: codigo, Quantidade: qtd };
            }).get();

            var lista = [];
            for (i = 0; i < componentes.length; i++) {
                lista[i] = { CodComponente: componentes[i].Codigo, CodRefeicaoPedido:0, Quantidade: componentes[i].Quantidade };
            }
            $.ajax({
                url: '@Url.Action("AdicionarRefeicao", "Pedidos")',
                type: "POST",
                dataType: "JSON",
                data: { codPedido: codPedido, codRefeicao: codRefeicao, codTamanho: codTamanho, quantidade: quantidade, codComponentes:lista, observacao: observacoes },
                success: function () {
                    PopularRefeicoes();
                    $("#quantidadeRef").val(1);
                    $("#observacao").val("");
                    $("#msgAddRef").removeClass("hidden");
                    AtualizarInterfaceComValorAtualPedido();
                }
            });
        }

        function PopularBebidas() {
            var codTipoBebida = $('#ddlCodTipoBebida').val();
            $.ajax({
                url: '@Url.Action("ObterBebidas", "Pedidos")',
                type: "POST",
                dataType: "JSON",
                data: { codTipoBebida: codTipoBebida },
                success: function (bebidas) {
                    $("#listaCodBebidas").html(""); // clear before appending new list
                    $.each(bebidas, function (i, bebida) {
                        $("#listaCodBebidas").append(
