        function ExibirMensagemBebida(ehErro, mensagem) {
            var msg = $("#msgAddBeb");
            msg.html(mensagem);
            if (ehErro) {
                msg.removeClass("alert-success hidden");
                msg.addClass("alert-danger");
            } else {
                msg.removeClass("alert-danger hidden");
                msg.addClass("alert-success");
            }
        }

        function ConfigurarLinkFecharPedido() {
            var botao = $("#hrefFecharPedido");

            var valor = 0;
            var acrRefCust = "";
            $(".txtAcrRefCust").each(function (i, e) {
                var txt = $("#" + e.id);
                acrRefCust += ";" + e.id.replace("acr-", "") + ":" + txt.val().replace(',', '.');
                valor += parseFloat(txt.val().replace(',', '.'));
            })
            if (acrRefCust.length > 0) {
                acrRefCust = acrRefCust.substring(1);
            }

            var imprimirCopiaFechamentoImprEntrega = false;
            var ckbImprimirCopiaFechamentoImprEntrega = $('#ckbImprimirCopiaFechamentoImprEntrega');
            if (ckbImprimirCopiaFechamentoImprEntrega != null) {
                imprimirCopiaFechamentoImprEntrega = ckbImprimirCopiaFechamentoImprEntrega.is(":checked");
            }

            var observacoes = $('#txtObservacoesFechamentoPedido').val();
            var maionese = false;
            var catchup = false;
            var mostarda = false;

            if ($('#ckbMaionese') != null)
                maionese = $('#ckbMaionese').is(":checked");

            if ($('#ckbCatchup') != null)
                catchup = $('#ckbCatchup').is(":checked");

            if ($('#ckbMostarda') != null)
                mostarda = $('#ckbMostarda').is(":checked");



            botao.attr("href", "@Url.Action("FecharPedido", "Pedidos", new { Codigo = Model.Codigo })" +
                "&acrecimos=" + $("#acrescimos").val().replace(',', '.') +
                "&descontos=" + $('#descontos').val().replace(',', '.') +
                "&acrescimosRefCustomizadas=" + acrRefCust +
                "&valorRecebido=" + parseFloat($("#valorRecebido").val().replace(',', '.')) +
                "&imprimirCopiaFechamentoImprEntrega=" + imprimirCopiaFechamentoImprEntrega +
                "&observacoes=" + observacoes +
                "&maionese=" + maionese +
                "&catchup=" + catchup +
                "&mostarda=" + mostarda
            );

            var lblValorTotal = $("#lblValorTotal");

            var valor = parseFloat('@Model.ValorRefeicoes'.replace(',','.')) + parseFloat('@Model.ValorBebidas'.replace(',','.'));

            if ($("#acrescimos").val() != "") {
                valor += parseFloat($("#acrescimos").val().replace(',', '.'));
            }
            if ($("#descontos").val() != "") {
                valor -= parseFloat($("#descontos").val().replace(',', '.'));
            }

            var valorEntrega = $("#lblValorEntrega").html();
            var valorComEntrega = valor;
            if (typeof valorEntrega !== 'undefined') {
                var valorEntrega = parseFloat(valorEntrega.replace(",", "."));
                valorComEntrega += valorEntrega;
            }


            lblValorTotal.html(valorComEntrega.toFixed(2).replace('.', ','));
            CalcularTroco();

            if (isNaN(valorComEntrega)) {
                botao.attr("href", "javascript:alert('Você tem valores inválidos digitados!')");
            }

            ConfigurarLinkCadastrarModelo();
        }

