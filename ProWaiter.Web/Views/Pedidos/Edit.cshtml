        function replaceLast(find, replace, string) {
            var lastIndex = string.lastIndexOf(find);

            if (lastIndex === -1) {
                return string;
            }

            var beginString = string.substring(0, lastIndex);
            var endString = string.substring(lastIndex + find.length);

            return beginString + replace + endString;
        }

        function AtualizarComponente(checkbox, codRefeicaoPedido, codComponente, alterarNud) {
            var adicionar = true;

            if(checkbox != null)
                adicionar = $(checkbox).prop("checked") == true;

            var nudId = "nud_" + codRefeicaoPedido.toString() + "_" + codComponente.toString();
            var nud = $("#" + nudId);

            if (alterarNud) {
                if (adicionar) {
                    nud.removeAttr("disabled")
                    nud.val(1);
                }
                else {
                    nud.attr("disabled", "disabled")
                    nud.val("");
                }
            }

            var qtd = nud.val();
            if (isNaN(qtd))
                qtd = 1;

            var componente = { CodComponente: codComponente, CodRefeicaoPedido: codRefeicaoPedido, Quantidade: qtd };

            $.ajax({
                url: '@Url.Action("AtualizarComponente", "Pedidos")',
                type: "POST",
                dataType: "JSON",
                data: { codRefeicaoPedido: codRefeicaoPedido, componente: componente, adicionar: adicionar },
                success: function () {
                    AtualizarInterfaceComValorAtualPedido();
                    AtualizarToolTipSaboresSelecionadosListagemRefeicao(codRefeicaoPedido);
                }
            });
        }

