                        </div><br />

                        @{
                            if (Model is PedidoExterno)
                            {
                                <div class="row">
                                    <label class="control-label col-md-4">Valor entrega</label>
                                    <label class="col-md-8" id="lblValorEntrega">@ViewBag.ValorEntrega</label>
                                </div><br />
                            }
                        }

                        <div class="row">
                            <div class="col-md-4">
                                <label class="control-label">@Html.DisplayNameFor(p => p.Observacoes)</label>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group">
                                    <input class="form-control controleParaFecharPedido" id="txtObservacoesFechamentoPedido" value="@Model.Observacoes" />
                                </div>
                            </div>
                        </div><br />

                        <div class="row">
                            <div class="col-md-4">
                                <label class="control-label">@Html.DisplayNameFor(p => p.Acrescimos)</label><button onclick='$("#acrescimos").val("@(String.Format("{0:N2}", (Model.ValorRefeicoes + Model.ValorBebidas) * 0.1M))"); ConfigurarLinkFecharPedido();' class="btn btn-sm">+10%</button>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group txtDinheiro">
                                    <span class="input-group-addon">R$</span>
                                    @Html.EditorFor(p => p.Acrescimos, new { htmlAttributes = new { @id = "acrescimos", @class = "form-control controleParaFecharPedido" } })
                                </div>
                            </div>
                        </div><br />
                        <div class="row">
                            <label class="control-label col-md-4">@Html.DisplayNameFor(p => p.Descontos)</label>
                            <div class="col-md-8">
                                <div class="input-group txtDinheiro">
                                    <span class="input-group-addon">R$</span>
                                    @Html.EditorFor(p => p.Descontos, new { htmlAttributes = new { @id = "descontos", @class = "form-control controleParaFecharPedido" } })
                                </div>
                            </div>
                        </div><br />

                        <div class="row">
                            <div class="col-md-4">
                                <label class="control-label">Valor recebido</label>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group txtDinheiro">
                                    <span class="input-group-addon">R$</span>
                                    <input class="form-control controleParaFecharPedido" id="valorRecebido" />
                                </div>
                            </div>
                        </div><br />
                        <div class="row">
                            <div class="col-md-4">
                                <label class="control-label">Troco</label>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group txtDinheiro">
                                    <span class="input-group-addon">R$</span>
                                    <input readonly class="form-control controleParaFecharPedido" id="troco" />
                                </div>
                            </div>
                        </div><br />


                        <div class="row">
                            <label class="control-label col-md-4">@Html.DisplayNameFor(p => p.ValorTotal)</label>
                            <label id="lblValorTotal" class="col-md-8">@Html.DisplayFor(p => p.ValorTotal)</label>
                        </div>

                        @{
                            if (Model is PedidoExterno pedidoExterno)
                            {
                                if (ViewBag.ExibirAdicionaisMolhosPedidoEntrega)
                                {
                                    <br />
                                    <div class="row">
                                        <div class="col-md-12">
                                            @if (!pedidoExterno.Maionese.HasValue) //Se um não tem valor é pq nunca foi setado
                                            {
                                                <input type="checkbox" id="ckbMaionese" checked />
                                                <label class="control-label" style="margin-right:10px" for="ckbMaionese">Maionese</label>
                                                <input type="checkbox" id="ckbCatchup" />
                                                <label class="control-label" style="margin-right:10px" for="ckbCatchup">Catchup</label>
                                                <input type="checkbox" id="ckbMostarda" />
                                                <label class="control-label" for="ckbMostarda">Mostarda</label>
                                            }
                                            else
                                            {
                                                string maioneseChecked = pedidoExterno.Maionese.Value ? "checked" : "";
                                                string catchupChecked = pedidoExterno.Catchup.Value ? "checked" : "";
                                                string mostardaChecked = pedidoExterno.Mostarda.Value ? "checked" : "";
                                                <input type="checkbox" id="ckbMaionese" @maioneseChecked />
                                                <label class="control-label" style="margin-right:10px" for="ckbMaionese">Maionese</label>
                                                <input type="checkbox" id="ckbCatchup" @catchupChecked />
                                                <label class="control-label" style="margin-right:10px" for="ckbCatchup">Catchup</label>
                                                <input type="checkbox" id="ckbMostarda" @mostardaChecked />
                                                <label class="control-label" for="ckbMostarda">Mostarda</label>
                                            }
                                        </div>
                                    </div>
                                }
                                <br />
                                <div class="row">
                                    <div class="col-md-12">
                                        @{
                                            if (ViewBag.ImprimirCopiaImpressoraEntrega)
                                            {
                                                <input type="checkbox" id="ckbImprimirCopiaFechamentoImprEntrega" checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox" id="ckbImprimirCopiaFechamentoImprEntrega" />
                                            }
                                        }
                                        <label class="control-label">Imprimir cópia na impressora de entrega</label>
                                    </div>
                                </div><br />
                            }
                        }
                        <br />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a id="btnCadastrarComoModelo" class="btn btn-primary pull-left" data-toggle="modal" data-target="#modalCadastrarComoModelo">Cadastrar como modelo</a>
                <a id="hrefFecharPedido" class="btn btn-primary controleParaFecharPedido">Fechar Pedido</a>
                <button type="button" class="btn btn-default" data-dismiss="modal" id="btnCancelarFecharPedido" onclick="limparLinkFecharPedido()">Cancelar</button>
            </div>
        </div>

    </div>
</div>

