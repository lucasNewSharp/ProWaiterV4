                        tooltip.attr("data-original-title", "");
                    }
                    else {

                        var html = '<div style="justify-content:left;">'
                        + "<div>Endereço: " + retorno.Endereco
                            + "</br>Bairro: " + retorno.Bairro
                            + "</br>Cidade: " + retorno.Cidade
                            + "</div>";

                        $("#ValorEntrega").val(retorno.ValorEntregaPadrao.toFixed(2).replace(".",","));
                        $("#txtObservacoesPedido").val(retorno.ObservacoesPadrao);


                        tooltip.attr("data-original-title", html);
                    }
