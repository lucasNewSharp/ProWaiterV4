<div id="modalEndereco" class="modal">
</div>

@{
    string msg = string.Empty;
}

<div>
    @Html.Partial("_botaoVoltarParaLista")
</div>

@Html.Partial("_janelaConfirmaExclusao")

@section scripts{
    <script src="~/Scripts/PesquisarNaTabela.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {

            $(".modelo").on("click", function () {
                var $this = $(this);
                $('.active').removeClass('active');
                $this.toggleClass('active')
            });

            $("#toolTipSaboresEscolhidosAddRefeicao").tooltip({ html: true, container: 'body' });
            $("#tooltipDadosEndereco").tooltip({ html: true, container: 'body' });

            //Tooltip itens selecionados na tela de listagem
            $(".toolTipComponentesCompostosClass").each(function () {
                $(this).tooltip({ html: true, container: 'body' });
            });

            $("#btnSalvarObsPedido").tooltip({ container: 'body' });
            $("#btnSalvarValorEntrega").tooltip({ container: 'body' });
            $("#toolTipoBotaoEnviarCozinha").tooltip({ container: 'body' });

            $("#txtObservacoesPedido").on("keypress", function (e) {
                var botao = $("#btnSalvarObsPedido");
                $("#txtObservacoesPedido").addClass("alert-danger").removeClass("alert-success");
            });


            var txtFiltroRefeicao = $("#filtroRefeicao");
            txtFiltroRefeicao.focus();
            txtFiltroRefeicao.keyup(function () { PesquisarNaSelectList('listaCodRefeicoes', $(this).val()) });

            var txtFiltroBebida = $("#filtroBebida");
            txtFiltroBebida.focus();
            txtFiltroBebida.keyup(function () { PesquisarNaSelectList('listaCodBebidas', $(this).val()) });

            $(".itemRefeicao").each(function (index) {
                var id = $(this).attr("data-target")
                var idBotao = "gi_" + id.replace('#', '');

                $(id).on("hide.bs.collapse", function (f) {
                    $('#' + idBotao).removeClass('glyphicon glyphicon-chevron-down').addClass('glyphicon glyphicon-chevron-right');
                });
                $(id).on("show.bs.collapse", function (f) {
                    $('#' + idBotao).removeClass('glyphicon glyphicon-chevron-right').addClass('glyphicon glyphicon-chevron-down');
                });
            });

            $(".liObservacoes").each(function (index, container) {
                var txtArea = $(container).find("textarea");
                txtArea.on("keypress", function (e) {
                    var liElement = $(e.target).closest(".liObservacoes");
                    var botao = liElement.find(".glyphicon-floppy-disk");
                    botao.removeClass("disabled");
                    txtArea.addClass("alert-danger").removeClass("alert-success");
                });
            });

            $("#ddlCodTipoRefeicao").on("change", PopularRefeicoes);
            $("#listaCodRefeicoes").on("change", PopularComponentes);
            $("#listaCodBebidas").on("change", ValidarAdicaoBebidas);
            $("#quantidadeBeb").on("keyup", ValidarAdicaoBebidas);

            $("#btnAdicionarItem").on("click", AdicionarItem);

            $("#btnAdicionarItensModelo").on("click", AdicionarItensModelo);

            $("#ddlCodTipoBebida").on("change", PopularBebidas);

            $("#ddlLocaisInternos").on("change", AtualizarLocalEntregaPedidoInterno);

            $(".controleParaFecharPedido").on("click", ConfigurarLinkFecharPedido);
            $(".controleParaFecharPedido").on("keyup", ConfigurarLinkFecharPedido);
            $(".controleParaCadastrarModelo").on("click", ConfigurarLinkCadastrarModelo);
            $(".controleParaCadastrarModelo").on("keyup", ConfigurarLinkCadastrarModelo);

            $("#valorRecebido").on("keyup", CalcularTroco);

            PopularBebidas();
            PopularRefeicoes();

            var modalAberta = '@ViewBag.NomeModalAberta';
            if (modalAberta != '') {
                $('#' + modalAberta).modal();
            }

            $('#acrescimos').on("focus", function () {
                this.select();
            });
            $('#descontos').on("focus", function () {
                this.select();
            });

            $("#valorRecebido").on("focus", function () {
                this.select();
            });

            $("#troco").val("0,00");
            $("#troco").on("focus", function () {
                this.select();
            });

            $("#qtdItemBalcao").on("focus", function () {
                this.select();
            });

            $("#qtdItemCodBarras").on("focus", function () {
                this.select();
            });
            //Chamamos aqui, pois ao criar um novo endereço a pagina é recarregada, então salvamos o endereço selecionado no pedido
            AtualizarEnderecoEntregaPedido();

            $("#txtCodBarras").focus();
            $("#txtCodBarras").on("keyup", function (e) {
                var keyCode = e.keyCode || e.which;
                if (keyCode === 13) {
                    AdicionarItemCodBarras();
                }
            });


            $("#ckbMarcarCodBarrasComoEnviado").on("change", function () {
                SalvarCoockies();
                $("#txtCodBarras").focus();
            })

            $("#ckbSomenteItensSemCodBarras").on("change", function () {
                SalvarCoockies();
                CarregarItensBalcao(this.checked);
            });


        });

         function limparLinkFecharPedido() {
                window.history.replaceState({}, document.title, "/ProWaiter/Pedidos/Edit/@Model.Codigo");
         }

        function CalcularTroco() {
            var valorTotal = parseFloat($("#lblValorTotal").text().replace(',', '.'));
            var valorRecebido = parseFloat($("#valorRecebido").val().replace(',', '.'));
            var troco = (parseFloat(valorRecebido) - parseFloat(valorTotal)).toFixed(2);

            if (isNaN(troco))
                $("#troco").val("");
            else
                $("#troco").val(troco.toString().replace('.', ','));
        }

        function PedirConfirmacao(href) {
            $("#hrefJanelaConfirmarExclusao").attr('href', href);
            $("#confirm-delete").modal();
            AtualizarInterfaceComValorAtualPedido();
        }

        function PopularRefeicoes() {
            var codTipoRefeicao = $('#ddlCodTipoRefeicao').val();
            $.ajax({
                url: '@Url.Action("ObterRefeicoes", "Pedidos")',
                type: "POST",
                dataType: "JSON",
                data: { codTipoRefeicao: codTipoRefeicao },
                success: function (refeicoes) {
                    $("#listaCodComponentes").html("");
                    $("#listaCodRefeicoes").html(""); // clear before appending new list
                    $.each(refeicoes, function (i, refeicao) {
                        $("#listaCodRefeicoes").append(
                            $('<option></option>').val(refeicao.Value).html(refeicao.Text));
                    });
                }
            });
        }

        var listaTotalComponentes = [];
        function PopularComponentes() {
            $("#msgAddRef").addClass("hidden");
            var itemSelecionado = $("#listaCodRefeicoes").find(":selected");
            var valores = itemSelecionado.attr("value").split(';');
            listaTotalComponentes = [];
            $.ajax({
                url: '@Url.Action("ObterComponentes", "Pedidos")',
                type: "POST",
                dataType: "JSON",
                data: { codRefeicao: valores[0], codTamanho: valores[1] },
                success: function (componentes) {
                    $("#listaCodComponentes").html(""); // clear before appending new list
                    var checked = ""
                    if (componentes.DeComposicao == false) {
                        $.each(componentes.lista, function (i, componente) {
                            var elemento = $("<li class='list-group-item col-md-12'></li>").html("<div class='col-md-11' style='padding:0px;'>" + componente.Nome + "</div><span class='col-md-1' style='padding:0px;'><input type='checkbox' class='chkAddComponente' checked='checked' value='" + componente.Codigo + "' /></span>");
                            $("#listaCodComponentes").append(elemento);
                            listaTotalComponentes.push(elemento);
                        });
                    } else {
                        $("#listaCodComponentes").append("<div class='form-group has-feedback col-md-12'><input type='text' id='inputFiltroComponentes' class='form-control' onkeyup='FiltrarComponentesComposicao(this)' /><i class='glyphicon glyphicon-search form-control-feedback' style='margin-right:15px;' /></div>");
                        $.each(componentes.lista, function (i, componente) {
                            var htmlQuantidade = "";
                            var idNud = "nudQtd_" + componente.Codigo;
                            var idTexto = "comp_" + componente.Codigo;
                            if (componente.PossuiUnidade) {
                                htmlQuantidade ="<span class='col-md-3' style='padding:0px;'>" +
                                                    "<input type='number' id='" + idNud +"' idDivTexto='"+ idTexto +"' class='form-control' disabled onchange='AtualizarToolTipSaboresSelecionadosAddRefeicao()'  />" +
                                                    "</span>";
                            }

                            var elemento = $("<li class='list-group-item col-md-12' style='vertical-align:central;'></li>")
                                .html("<div class='col-md-8 textoItemComponenteComposto' style='padding:0px; vertical-align:central;' id='" + idTexto + "'>" + componente.Nome + "</div>" +
                                "<span class='col-md-1' style='padding:0px;'>" +
                                "<input type='checkbox' class='chkAddComponente' style='vertical-align:central;' onclick='HabilitarQuantidade(this);' idNud='"+idNud+"' value='" + componente.Codigo + "' />" +
                                    "</span>" + htmlQuantidade)
                            $("#listaCodComponentes").append(elemento);
                            listaTotalComponentes.push(elemento);
                        });
                    }
                }
            });
        }

        function FiltrarComponentesComposicao(elemento) {
            //pegamos a referencia para a div que contem os componentes
            var lista = $("#listaCodComponentes");

            //obtemos o texto do filtro
            var textoFiltro = "";
            if(elemento != null)
                textoFiltro = $(elemento).val().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

            //limpamos os componentes da div
            lista.find(".list-group-item").remove();

            //iteramos sobre os itens adicionando na pagina somente o que bate com o texto
            for (i = 0; i < listaTotalComponentes.length; i++) {
                var el = $(listaTotalComponentes[i]).find(".textoItemComponenteComposto");
                var texto = el.text().toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                if (textoFiltro == "" || texto.includes(textoFiltro)) {
                    lista.append(listaTotalComponentes[i]);
                }
            }

        }

        function HabilitarQuantidade(checkbox) {

            var idNud = $(checkbox).attr("idNud");
            var nud = $('#' + idNud);

            if ($(checkbox).prop("checked") == true) {
                nud.removeAttr("disabled");
                nud.val(1);
            }
            else {
                nud.attr("disabled", "disabled");
                nud.val("");
            }
            AtualizarToolTipSaboresSelecionadosAddRefeicao();
        }

        function AtualizarToolTipSaboresSelecionadosAddRefeicao() {

            var divConteudo = "<div>";
            var htmlConteudo = "";

            var listaSaboresSelecionados = $("#toolTipSaboresEscolhidosAddRefeicao");
            for (i = 0; i < listaTotalComponentes.length; i++) {

                var checkbox = $($(listaTotalComponentes[i]).find("input:checkbox"));
                if (checkbox.prop("checked") == true) {
                    var nomeComponente = $(listaTotalComponentes[i]).find("div").html();
                    var quantidade = $($(listaTotalComponentes[i]).find(":input[type='number']")).val();

                    if (!isNaN(quantidade)) {
                        nomeComponente += " (" + quantidade + ")"
                    }

                    htmlConteudo += nomeComponente + "<br />";
                }
            }

            divConteudo += htmlConteudo + "</div>"
            listaSaboresSelecionados.attr("data-original-title", divConteudo);
        }

