<dt>
    @Html.DisplayNameFor(model => model.RefeicoesDoPedido)
</dt>
<dd>
    <div class="col-md-4 list-group">
        @{
            int i = 0;
        }
        @foreach (var refeicao in Model.RefeicoesDoPedido.GroupBy(r => r.RefeicaoDoCardapio.Refeicao.Nome, (key, g) => new { Nome = key, Qtd = g.Count() }))
        {
            <div class="list-group-item">
                <div data-toggle="collapse" data-target="#@i" style="display:inline" class="itemRefeicao">
                    <div class="glyphicon glyphicon-chevron-right" id="gi_@i">
                        @refeicao.Nome
                    </div>
                </div>
                <span class="badge">@refeicao.Qtd</span>
            </div>
            <div id="@i" class="collapse row">
                <ul>
                    @foreach (var refeDet in Model.RefeicoesDoPedido)
                    {
                        if (refeDet.RefeicaoDoCardapio.Refeicao.Nome != refeicao.Nome)
                        {
                            continue;
                        }

                        <li class="list-group-item col-md-12">
                            <div class="col-md-11" style="padding:0px;">
                                @refeDet.NomeUsuario

                                @{
                                    string hora = refeDet.DataHora.HasValue ? refeDet.DataHora.Value.ToShortTimeString() : string.Empty;
                                }

                                @hora
                            </div>
                        </li>
                    }
                </ul>
            </div>
            i++;
        }
    </div>
</dd>

