@model ProWaiter.Web.Models.EditUserViewModel

@{
    ViewBag.Title = "Edição do Usuário";
}

<h2>Editar Usuário</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Usuário</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.UserName, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <input type="text" readonly="readonly" value="@Model.UserName" class="form-control" />
            </div>
        </div>  
        <div class="form-group">
            @Html.LabelFor(model => model.EhAdministrador, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.EhAdministrador)
                    @Html.ValidationMessageFor(model => model.EhAdministrador, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.EhCaixa, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.EhCaixa)
                    @Html.ValidationMessageFor(model => model.EhCaixa, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.EhGarcom, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.EhGarcom)
                    @Html.ValidationMessageFor(model => model.EhGarcom, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                @Html.Partial("_botaoSalvar")
            </div>
        </div>
    </div>
}

<div>
    @Html.Partial("_botaoVoltarParaLista")
</div>



