@model ProWaiter.Web.Models.RefeicaoViewModel

@{
    ViewBag.Title = "Refeição";
}

<h2>@AppResources.StringDetalhes</h2>

<div>
    <h4>@ViewBag.Title</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Nome)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.NomeTipo)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NomeTipo)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Componentes)
        </dt>
        <dd>
            <ul>
                @foreach (KeyValuePair<string, string> item in Model.Componentes.ListaSelecionados)
                {
                    <li>@item.Value</li>
                }
            </ul>
        </dd>
    </dl>
</div>
<p>
    @Html.Partial("_botaoVoltarParaLista")
    @Html.Partial("_botaoEditar", new { id = Model.Codigo })
</p>



