@model ProWaiter.Web.Models.Entidades.Mesa
@using ProWaiter.Web.Util

@{
    ViewBag.Title = Configuracoes.ObterInstancia().UtilizaComanda ? "Comanda" : "Mesa";
}

<h2>@AppResources.StringDetalhes</h2>

<div>
    <h4>@ViewBag.Title</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Descricao)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.CodUltimoPedido)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CodUltimoPedido)
        </dd>
    </dl>
</div>
<p>
    @Html.Partial("_botaoVoltarParaLista")
    @Html.Partial("_botaoEditar", new { id = Model.Codigo })
</p>



