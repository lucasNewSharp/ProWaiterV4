@model IEnumerable<ProWaiter.Web.Models.Entidades.TipoBebida>

@{
    ViewBag.Title = "Tipos de Bebidas";
}

<h2>Tipos de Bebida</h2>

<p>
    <partial name="_botaoCriarNovo" />
</p>
<partial name="_pesquisarnaTabelaClient" />
<table class="table table-striped table-hover table-condensed" id="tabelaDados">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Nome)
        </th>
        <th style="text-align:center;">Ações</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                <partial name="_botoesAcaoIndex" model="new { id = item.Codigo }" />
            </td>
        </tr>
    }

</table>
@section scripts{
    <script src="~/Scripts/PesquisarNaTabela.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var txt = $("#txtFiltro");
            txt.focus();
            txt.keyup(function () { PesquisarNaTabela('tabela', $(this).val()) });
        });
    </script>
}


