@model IEnumerable<ProWaiter.Web.Models.Entidades.RefeicaoDoCardapio>

@{
    ViewBag.Title = "Refeições do cardápio";
}

<h2>@ViewBag.Title</h2>

<p>
    @Html.Partial("_botaoCriarNovo")
</p>
@Html.Partial("_pesquisarnaTabelaClient")
<table class="table table-hover" id="tabela">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Refeicao.Nome)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TamanhoRefeicao.Nome)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Valor)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Ativo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DeComposicao)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Impressora)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PercDesconto)
        </th>
        <th style="text-align:center;">Ações</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Refeicao.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TamanhoRefeicao.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Valor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ativo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DeComposicao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Impressora.NomeExibicao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PercDesconto)%
            </td>
            <td width="150px">
                @Html.Partial("_botoesAcaoIndex", new { codRefeicao = item.CodRefeicao, codTamanho = item.CodTamanho })
            </td>
        </tr>
    }

</table>

@section scripts{
    <script src="~/Scripts/PesquisarNaTabela.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var txt = $("#txtFiltro");
            txt.focus();
            txt.keyup(function () { PesquisarNaTabela('tabela', $(this).val()) });
        });
    </script>
}



