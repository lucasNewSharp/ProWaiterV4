@model IEnumerable<ProWaiter.Web.Models.Entidades.ConfiguracoesCategorias>

@section css {
    <style type="text/css">
        #sortable li:hover {
            cursor: move;
        }
    </style>
}

@{ ViewBag.Title = "Configurações das Categorias"; }

@{
    if (!string.IsNullOrWhiteSpace(ViewBag.MsgSucesso))
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            @ViewBag.MsgSucesso
        </div>
    }
}

<h2>@ViewBag.Title</h2>
<br />
<p>Organize as categorias como preferir arrastando-as.</p>
@using (Html.BeginForm("Salvar", "ConfiguracoesCategorias", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <ul class="list-group" id="sortable">
        @foreach (var item in Model)
        {
            <li id="@item.ID" class="list-group-item row ui-state-default" style="color:@item.CorFonte; background-color:@item.CorFundo">
                <div class="col-md-8">
                    @item.Nome
                    <input type="hidden" name="ids" value="@item.ID" />
                </div>
                <div class="col-md-2" style="color:black">Fundo: <input type="color" value="@item.CorFundo" name="cfu_@item.ID" onchange="$('#' + '@item.ID').css('background-color', this.value);" /></div>
                <div class="col-md-2" style="color:black">Fonte: <input type="color" value="@item.CorFonte" name="cfo_@item.ID" onchange="$('#' + '@item.ID').css('color', this.value);" /></div>
            </li>
        }
    </ul>
    <input type="submit" class="btn btn-default" value="Salvar" />
}

@section scripts {
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    <script>
        $(function () {
            $("#sortable").sortable();
            $("#sortable").disableSelection();
        });
    </script>
}