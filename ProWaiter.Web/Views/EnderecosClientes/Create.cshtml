@model ProWaiter.Web.Controllers.EnderecoClienteViewModel

@{
    ViewBag.Title = "Endereço do cliente";
    Layout = null;
}

<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal">&times;</button>
            <h4 class="modal-title">@ViewBag.Title</h4>
        </div>
        <div class="modal-body">
            @using (Html.BeginForm("Create", "EnderecosClientes", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, htmlAttributes: new { @id = "formCadastroEnderecoCliente" }))
            {


                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.CodCliente)
                    <div class="form-group">
                        @Html.LabelFor(model => model.Endereco, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.Endereco, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Endereco, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Bairro, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.Bairro, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Bairro, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Estados", "Estados", new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.DropDownList("CodUF", null, new { @class = "form-control", @id = "ddlEstados", @onchange = "PopularCidades();" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.CodCidade, "Cidade", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            <select name="CodCidade" class="form-control" id="ddlCidades">
                                @foreach (var cidade in (List<ProWaiter.Web.Models.Entidades.Cidade>)ViewBag.Cidades)
                                {
                                    string selected = "";
                                    if (cidade.Codigo == Model.CodCidade)
                                    {
                                        selected = "selected";
                                    }
                                    <option value="@cidade.Codigo" @selected>@cidade.Nome</option>
                                }
                            </select>
                            @Html.ValidationMessageFor(model => model.CodCidade, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ValorEntregaPadrao, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.ValorEntregaPadrao, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ValorEntregaPadrao, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ObservacoesPadrao, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.EditorFor(model => model.ObservacoesPadrao, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ObservacoesPadrao, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @Html.Partial("_botaoCadastrar")
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
        function PopularCidades() {
                var stateId = $('#ddlEstados').val();
                $.ajax({
                    url: '@Url.Action("LoadCidades", "Clientes")',
                    type: "POST",
                    dataType: "JSON",
                    data: { uf: stateId },
                    success: function (cities) {
                        $("#ddlCidades").html(""); // clear before appending new list
                        $.each(cities, function (i, city) {
                            $("#ddlCidades").append(
                                $('<option></option>').val(city.Value).html(city.Text));
                        });
                    }
                });
        }
</script>

