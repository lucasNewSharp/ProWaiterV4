<UserControl x:Class="Instalador.Controles.UCInstalacao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Instalador.Controles"
             mc:Ignorable="d" d:DesignWidth="800" Height="180.132">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="30" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtTitulo" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Título" FontSize="18" FontWeight="Bold" Height="24"></TextBlock>
        <ProgressBar x:Name="progressBar" IsIndeterminate="True" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="5,5,5,5" Height="20"></ProgressBar>
        <TextBox IsReadOnly="True" x:Name="txtTexto" Grid.Row="2" VerticalScrollBarVisibility="Visible" TextWrapping="Wrap" Margin="5,5,5,5"></TextBox>
    </Grid>
</UserControl>
