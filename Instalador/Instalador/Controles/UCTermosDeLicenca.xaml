<UserControl x:Class="Instalador.Controles.UCTermosDeLicenca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Instalador.Controles"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="71*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Content="Termos de Licença e condições de uso" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="5,5,0,0"></Label>
        <TextBox BorderThickness="2,2,1,1" x:Name="txtTermos" Grid.Row="1" VerticalScrollBarVisibility="Visible" Background="#f0f0f0" TextWrapping="Wrap"></TextBox>
        <CheckBox x:Name="ckbAceito" Content="Aceito as condições e os termos de licença" Grid.Row="2" Margin="5,8,0,0" Checked="CheckBox_Checked" Unchecked="CheckBox_Checked" IsThreeState="False"></CheckBox>
    </Grid>
</UserControl>
