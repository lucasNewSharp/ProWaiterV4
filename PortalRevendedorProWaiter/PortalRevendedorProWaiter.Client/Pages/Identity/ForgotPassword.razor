@page "/ForgotPassword"
@inject IAuthService AuthService;

<AlertError Message="@msgExErro"></AlertError>

@if (showWaitComponent)
{
    <WaitComponent Texto="Enviando email para alteração de senha..."></WaitComponent>
}
else
{

    @if (showErrors)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var error in errors)
            {
                <p>@error</p>
            }
        </div>
    }

    @if (showSuccessMessage)
    {
        <div class="alert alert-success" role="alert">
            <p>Um e-mail foi enviado para você alterar a sua senha</p>
        </div>
    }
    else
    {
        <h3>Esquece a senha?</h3>
        <div class="d-flex justify-content-center">
            <div class="card col-md-6">
                <div class="card-body">
                    <h5 class="card-title">Digite o seu email</h5>
                    <EditForm Model="forgotPasswordModel" OnValidSubmit="HandleForgotPassword">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-group">
                            <label for="email">Endereço de email</label>
                            <InputText Id="email" class="form-control" @bind-Value="forgotPasswordModel.Email" />
                            <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
                        </div>
                        <button type="submit" class="btn btn-primary">Alterar Senha</button>
                    </EditForm>
                </div>
            </div>
        </div>
    }
}


@code {

    private ForgotPasswordModel forgotPasswordModel = new ForgotPasswordModel();
    private bool showErrors;
    private IEnumerable<string> errors;
    private bool showSuccessMessage;
    private bool showWaitComponent;
    private string msgExErro;

    private async Task HandleForgotPassword()
    {
        try
        {
            showErrors = false;
            showWaitComponent = true;
            msgExErro = string.Empty;

            var result = await AuthService.ResendForgotPasswordEmail(forgotPasswordModel);

            if (result.Successful)
            {
                showSuccessMessage = true;
            }
            else
            {
                showErrors = true;
                errors = result.Errors;
            }
        }
        catch (Exception ex) { msgExErro = ex.ToString(); }
        finally { showWaitComponent = false; }
    }
}
