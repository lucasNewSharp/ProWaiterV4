@model ProWaiter.Web.Models.Entidades.LocalInterno

@{
    ViewBag.Title = "Local Interno";
}

<h2>@AppResources.StringExcluir</h2>

<h3>@AppResources.StringPerguntaExclusao</h3>
<div>
    <h4>@ViewBag.Title</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Nome)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nome)
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            @Html.Partial("_botaoVoltarParaLista")
            @Html.Partial("_botaoExcluir")
        </div>
    }
</div>
